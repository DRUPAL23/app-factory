generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Publisher {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  websites  Website[]
  campaigns Campaign[]
  affiliates AffiliateAccount[]
}

model Website {
  id          String        @id @default(cuid())
  publisherId String
  domain      String        @unique
  name        String
  status      String        @default("active")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publisher   Publisher     @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  content     Content[]
  placements  AdPlacement[]
}

model Content {
  id          String      @id @default(cuid())
  websiteId   String
  title       String
  slug        String      @unique
  status      String      @default("draft")
  body        String?
  keywords    String[]
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  website     Website     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  clicks      Click[]
}

model Campaign {
  id          String   @id @default(cuid())
  publisherId String
  name        String
  status      String   @default("draft")
  budget      Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  ads         Ad[]
}

model Ad {
  id          String        @id @default(cuid())
  campaignId  String
  name        String
  targetUrl   String
  creativeUrl String?
  status      String        @default("active")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  campaign    Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  placements  AdPlacement[]
}

model AdPlacement {
  id        String   @id @default(cuid())
  websiteId String
  adId      String
  position  String
  active    Boolean  @default(true)
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  clicks    Click[]
  @@index([websiteId, position])
}

model AffiliateAccount {
  id          String   @id @default(cuid())
  publisherId String
  network     String
  externalId  String?
  status      String   @default("active")
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  offers      Offer[]
}

model Offer {
  id          String            @id @default(cuid())
  accountId   String
  name        String
  merchant    String
  url         String
  commission  Decimal?          @db.Decimal(10, 2)
  epc         Decimal?          @db.Decimal(10, 4)
  status      String            @default("active")
  account     AffiliateAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  referrals   Referral[]
}

model Referral {
  id         String    @id @default(cuid())
  offerId    String
  clickId    String?
  externalId String?
  status     String    @default("pending")
  revenue    Decimal?  @db.Decimal(12, 2)
  createdAt  DateTime  @default(now())
  offer      Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  @@index([clickId])
}

model Click {
  id          String       @id @default(cuid())
  contentId   String?
  placementId String?
  referralId  String?
  sessionId   String?
  createdAt   DateTime     @default(now())
  content     Content?     @relation(fields: [contentId], references: [id], onDelete: SetNull)
  placement   AdPlacement? @relation(fields: [placementId], references: [id], onDelete: SetNull)
  @@index([createdAt])
  @@index([referralId])
}
